# ==========================================
# GMAIL / SMTP EMAIL SOZLAMALARI
# ==========================================
# Gmail orqali kod yuborish uchun:
# 1. Google hisobingizda 2 bosqichli tekshiruv (2-Step Verification)ni yoqing.
# 2. https://myaccount.google.com/apppasswords manziliga kiring.
# 3. Yangi "Ilova paroli" (App Password) yarating (masalan, "WisdomApp").
# 4. Chiqqan 16 belgili parolni SMTP_PASS qatoriga bo'shliqlarsiz yozing.
#
# Eslatma: Agar SMTP sozlamalari kiritilmasa yoki sinov rejimida bo'lsa,
# dastur avtomatik ravishda xavfsizlik kodini server konsoliga chiqaradi
# va sinov uchun javobda ko'rsatadi, shunda dastur hech qachon to'xtab qolmaydi!

SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Wisdom Dictionary" <no-reply@wisdom-app.uz>
